{
  "name": "lupo-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node scripts/with-java.mjs firebase emulators:exec --only firestore,storage --project demo-lupo \"node scripts/real-cwd.mjs vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "node scripts/with-java.mjs firebase emulators:exec --only auth,firestore,storage --project demo-lupo \"node scripts/real-cwd.mjs npm run e2e:run\"",
    "emulators": "node scripts/emulators.mjs",
    "seed": "tsx --conditions=react-server scripts/import-lupo.ts",
    "seed:prod": "tsx --conditions=react-server scripts/import-lupo.ts --prod",
    "set-role": "tsx --conditions=react-server scripts/set-role.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "brand:logo": "tsx scripts/brand/logo.ts",
    "capture": "tsx scripts/reference/capture.ts",
    "e2e:run": "npm run seed -- --reset && playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@lucide/lab": "^0.17.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.37.0",
    "potrace": "^2.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
