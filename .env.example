NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-lupo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lupo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-lupo.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_EMULATORS=true
FIREBASE_CLIENT_EMAIL=             # server only (production): client_email from the service-account JSON
FIREBASE_PRIVATE_KEY=              # server only (production): private_key from the same JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=   # alternative to the two above (too large for Netlify/Lambda 4 KB env limit)
REVIEW_HASH_SECRET=                # long random string (openssl rand -hex 32)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=    # optional
TURNSTILE_SECRET_KEY=              # optional
