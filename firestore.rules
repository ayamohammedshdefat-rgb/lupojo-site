rules_version = '2';

// LUPO: default deny. The public never reads Firestore directly (Server Components use the Admin SDK),
// and NOBODY writes from a client: every mutation goes through a Server Action / Route Handler.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : '';
    }
    function isStaff() {
      return role() in ['owner', 'staff'];
    }
    function isOwner() {
      return role() == 'owner';
    }

    // Live dashboard listeners (staff and owner).
    match /sections/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /items/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /itemStats/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Personal data and the audit trail: owner only.
    match /reviewContacts/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /auditLog/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Server-only (rate-limit counters and anything else).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
